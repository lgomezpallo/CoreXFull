# Copiar como referencia; el proyecto no carga este archivo automáticamente.
# Definir estas variables en el entorno del proceso que inicia el API.
PORT=8080
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/prisma
AI_ROUTER_BASE_URL=https://router.example.com/api/v1
AI_ROUTER_API_KEY=
AI_ROUTER_CHAT_MODEL=router-ia-auto
AI_ROUTER_STREAM=false
AI_ROUTER_IMAGE_MODEL=

# Definir al iniciar Expo; URL pública del API, no un token.
EXPO_PUBLIC_DOMAIN=http://localhost:8080
